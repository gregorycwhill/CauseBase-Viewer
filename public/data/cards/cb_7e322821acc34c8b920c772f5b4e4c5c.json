  "activities": [
    "Symphony and concert series at Adelaide Town Hall, Elder Hall and Festival Theatre",
    "Regional touring and community concerts in South Australia (Peterborough, Clare, mid‑north)",
    "Learning and schools programmes including commissioned school works and incursions",
    "Community projects and participatory work (Floods of Fire)",
    "Collaborations with festivals and companies (Adelaide Festival, WOMADelaide, State Opera, The Australian Ballet)",
    "Digital and broadcast programming (Virtual Concert Hall, online mini‑recitals, Silos & Symphonies)"
  ],
  "beneficiaries": [
    "Audiences in metropolitan Adelaide",
