  "summary": {
    "derivative_id": "der:rc4:cb_9b0604e86cb24d31bbda5d23a6e22235:summary",
    "text": "Ann Street Presbyterian Church is a Presbyterian congregation in Queensland, Australia. Materials associated with the Presbyterian Church of Queensland indicate congregations in the state are supported through Christian education programming, hospital chaplaincy, ministry resourcing for individual congregations, women\u2019s ministries, youth and children\u2019s ministry, the PIM Gap Year programme, and PCQ events and public programming. The congregation has pathways for people to attend PCQ events, enrol in ministry programmes and access congregational resources and training materials."
  },
